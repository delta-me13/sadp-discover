// Windows resources for sadp-discover.
//
// crates/sadp-cli/build.rs and crates/sadp-gui/build.rs read this template,
// substitute the @placeholders@ (version, absolute paths) and hand the result
// to rc.exe. Keep this file pure ASCII: rc.exe reads .rc with the build
// machine's ANSI code page, so any non-ASCII byte here can corrupt the output.
//
// Three resources:
//   1 ICON        - Explorer / taskbar / shortcut icon
//   1 24          - application manifest (RT_MANIFEST): DPI awareness, asInvoker
//   1 VERSIONINFO - file properties -> "Details", also read by the installer

1 ICON "@ICON@"

1 24 "@MANIFEST@"

1 VERSIONINFO
FILEVERSION @VER_NUM@
PRODUCTVERSION @VER_NUM@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0 = US English / Unicode. ASCII only, for the same reason as above.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "delta-me13"
            VALUE "FileDescription", "@DESCRIPTION@"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "@INTERNAL_NAME@"
            VALUE "LegalCopyright", "sadp-discover contributors, MIT OR Apache-2.0"
            VALUE "OriginalFilename", "@ORIGINAL_FILENAME@"
            VALUE "ProductName", "sadp-discover"
            VALUE "ProductVersion", "@VERSION@"
            VALUE "Comments", "https://github.com/delta-me13/sadp-discover"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END
